# Copy to a private deployment environment file. Every value is required; no production value belongs in Git.
# Fully qualified immutable image references (registry/name@sha256:...). Confirm the existing DB major version first.
NEXUS_POSTGRES_IMAGE=
PUBLIC_API_IMAGE=
ADMIN_API_IMAGE=
STUDIO_API_IMAGE=
STUDIO_WEB_IMAGE=
CADDY_IMAGE=
# Existing production PostgreSQL Docker volume; never guess or create automatically.
NEXUS_DB_VOLUME=
NEXUS_BACKUP_VOLUME=
# Review existing Docker networks, then choose a non-overlapping private edge subnet.
NEXUS_EDGE_SUBNET=
# Root-owned private directory; file ownership depends on the consuming image UID (docs/deployment.md).
NEXUS_SECRET_DIR=
# Reviewed checkout containing this Compose file; used by the backup host wrapper.
NEXUS_REPO_DIR=
# DNS names controlled by the operator. Do not use an IP address for automatic TLS.
API_DOMAIN=
STUDIO_DOMAIN=
ACME_EMAIL=
# Root-owned host directory for local logical backups; off-VPS copy is separate.
BACKUP_DIR=
