{
    email {$ACME_EMAIL}
    log {
        output stdout
        format json
    }
}

(headers) {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        -Server
    }
}

{$API_DOMAIN} {
    import headers
    encode zstd gzip
    reverse_proxy public-api:8080
}
