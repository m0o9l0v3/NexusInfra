# PG17 edge専用。PG18の.env.example / /etc/nexus/production.envと混同しない。
# 推奨配置: /etc/nexus/pg17-edge.env。秘密・実値はGitに置かない。
# レビューしたregistry/name@sha256:...を指定。タグで本番を動かさない。
PG17_EDGE_PUBLIC_API_IMAGE=
PG17_EDGE_CADDY_IMAGE=
# 初期CORSはAPI自身のHTTPS originのみ。別originのLP接続前に再判断する。
PG17_EDGE_API_DOMAIN=
PG17_EDGE_ACME_EMAIL=
# 既存PG17のnetwork実名を読み取り確認して指定。推測しない。
PG17_EDGE_BACKEND_NETWORK=
# 非衝突のprivate IPv4 /24〜/28。KnownNetworksにも同じ値を渡す。
PG17_EDGE_SUBNET=
# public_connection / audit_keyを持つ私有ディレクトリ（絶対パス）。
PG17_EDGE_SECRET_DIR=
