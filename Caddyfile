{
    email {$ACME_EMAIL}
    log {
        output stdout
        format json
    }
}

(headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        -Server
    }
}

{$API_DOMAIN} {
    import headers
    encode zstd gzip
    reverse_proxy public-api:8080
}

{$STUDIO_DOMAIN} {
    import headers
    encode zstd gzip
    handle /health {
        reverse_proxy studio-api:8080
    }
    handle /api/* {
        reverse_proxy studio-api:8080
    }
    handle {
        reverse_proxy studio-web:8080
    }
}
